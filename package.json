{
  "name": "persistent-repl-workspace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <25"
  },
  "workspaces": [
    "packages/*",
    "examples/electron"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:core": "node --test test/semantics.test.mjs test/host.test.mjs test/protocol.test.mjs test/recovery.test.mjs",
    "test:cua": "node --test test/cua.test.mjs test/conformance.test.mjs",
    "test:mcp": "node --test test/mcp.test.mjs",
    "test": "npm run build && npm run test:core && npm run test:cua && npm run test:mcp",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm test && npm run check:boundaries && npm run demo && npm run demo:cua && npm run demo:mcp && npm run demo:contract",
    "demo": "node examples/generic.mjs",
    "demo:cua": "node examples/cua.mjs",
    "demo:mcp": "node examples/mcp-client.mjs",
    "demo:electron": "electron examples/electron",
    "bench": "node scripts/bench.mjs",
    "pack:all": "node scripts/pack.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "accept": "node scripts/accept.mjs",
    "inventory": "node scripts/inventory.mjs",
    "format": "prettier --write packages/*/src test examples scripts",
    "format:check": "prettier --check packages/*/src test examples scripts",
    "demo:contract": "node examples/backend-contract.mjs"
  },
  "devDependencies": {
    "@types/babel__core": "7.20.5",
    "@types/babel__generator": "7.27.0",
    "@types/babel__traverse": "7.28.0",
    "@types/node": "22.20.2",
    "@types/pngjs": "6.0.5",
    "electron": "44.3.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
